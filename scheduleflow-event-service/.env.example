# ============================================================================
#  EVENT-SERVICE — Local Development Environment Variables
#  Template file: committed to the repository as documentation.
#
#  ► Copy this file to scheduleflow-event-service/.env and fill in values.
#  ► .env is gitignored and will never be committed.
#  ► Never paste real credentials into this file.
# ============================================================================

# ── Database ───────────────────────────────────────────────────────────────
# Shared Neon database — change DATABASE_URL here only when migrating to
# a dedicated scheduleflow_event database.
DATABASE_URL=jdbc:postgresql://<YOUR_NEON_HOST>.neon.tech/neondb?sslmode=require&channel_binding=require
DB_USER=<YOUR_NEON_USERNAME>
DB_PASS=<YOUR_NEON_PASSWORD>

# ── JPA / Hibernate ────────────────────────────────────────────────────────
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8083

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
