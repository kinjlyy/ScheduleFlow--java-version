# ============================================================================
#  TIMETABLE-SERVICE — Local Development Environment Variables
#  Template file: committed to the repository as documentation.
#
#  ► Copy this file to backend/.env and fill in your real values.
#  ► backend/.env is gitignored and will never be committed.
#  ► Never paste real credentials into this file.
# ============================================================================

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Full JDBC connection string from Neon Console → Connection Details.
# sslmode=require is mandatory for Neon.
DATABASE_URL=jdbc:postgresql://<YOUR_NEON_HOST>.neon.tech/scheduleflow?sslmode=require

# Neon role username (Neon Console → Connection Details → User)
DB_USER=<YOUR_NEON_USERNAME>

# Neon role password (Neon Console → Connection Details → Password)
DB_PASS=<YOUR_NEON_PASSWORD>

# ── JPA / Hibernate ────────────────────────────────────────────────────────
# update  → Hibernate applies schema changes without dropping existing data.
# validate → Hibernate checks schema matches entities but makes no changes.
JPA_DDL_AUTO=update

# Set to true to print all SQL statements to the console during local dev.
JPA_SHOW_SQL=true

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── JWT (required for local auth endpoints) ────────────────────────────────
# Generate a secure random hex string (min 64 chars). Example:
#   openssl rand -hex 64
JWT_SECRET=<YOUR_LOCAL_JWT_SECRET>

# Token expiry in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
